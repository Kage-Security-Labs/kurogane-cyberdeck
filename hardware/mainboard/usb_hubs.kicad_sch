  (text "USB_Hubs" (exclude_from_sim no) (at 15.00 15.00 0)
    (effects (font (size 3.00 3.00)) (justify left top)) (uuid "92aefd98-c740-49ac-8c30-bf367be0f557"))
  (text "USB3_0 -> VL817 (4 ports): P1 M.2 B-key modem, P2 rear USB-A, P3 left USB-A, P4 internal USB-C.\nUSB3_1 -> right USB-C host port (5 Gb/s), VBUS 1.5 A via current-limit switch.\nUSB2 -> TS3USB221 mux: SEL=nRPIBOOT switch. A: USB2514B hub, B: charge-port USB-C D+/D-.\nUSB2514B: P1 keyboard (FPC), P2 DeckBus L, P3 DeckBus R, P4 internal header.\nPer-port VBUS current-limit switches from +5V_B; ESD arrays at every external connector." (exclude_from_sim no) (at 15.00 25.00 0)
    (effects (font (size 1.50 1.50)) (justify left top)) (uuid "06deba3a-7fbb-42db-a19c-023bf19e9330"))
)
