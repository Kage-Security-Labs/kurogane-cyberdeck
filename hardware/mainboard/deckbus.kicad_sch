  (title_block (title "DeckBus") (rev "A") (company "Kurogane K-7"))
  (lib_symbols)
  (text "DeckBus" (exclude_from_sim no) (at 15.00 15.00 0)
    (effects (font (size 3.00 3.00)) (justify left top)) (uuid "d05ff4f0-1693-4ea7-869c-de90e73d811b"))
  (text "Two bays, identical. 2x10 pogo block per bay, pinout in docs/deckbus_v1.md.\nPer bay: TPS25947 eFuse on VSYS (2 A), TPS22965 on +5V_B (2 A), 3V3 via 300 mA limit,\nUSB2 from USB2514B, I2C via PCA9546A channel (bay L = ch0, bay R = ch1), UART2 (L) / UART3 (R),\nGPIO A/B, MOD_DET# with 200 ms RC + Schmitt to eFuse/load-switch EN and to a CM5 GPIO.\nVCHG_IN -> LM66100 ideal diode -> BQ25792 VAC2 (in Power sheet).\nTVS on every pogo pin; 0R in series on data lines for hot-plug tuning." (exclude_from_sim no) (at 15.00 25.00 0)
    (effects (font (size 1.50 1.50)) (justify left top)) (uuid "848e4c0e-a57e-47cc-9af3-913cd7c75ccb"))
)
