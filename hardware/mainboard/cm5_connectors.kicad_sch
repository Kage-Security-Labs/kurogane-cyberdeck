  (text "CM5_Connectors" (exclude_from_sim no) (at 15.00 15.00 0)
    (effects (font (size 3.00 3.00)) (justify left top)) (uuid "e79ad059-7cde-429a-894b-717c66ac8e9a"))
  (text "2 x 100-pin 0.4 mm receptacles: Hirose DF40HC(3.0)-100DS-0.4V(51) or Amphenol 10164227-1004A1RLF.\nSTART HERE: copy the CM5 connector symbols/footprints and pin naming from the official\nCM5 IO Board KiCad files (pip.raspberrypi.com, 'CM5 IO Board, revision 2, KiCAD files').\nExpose as hierarchical labels: USB3_0, USB3_1, USB2, PCIE, MIPI0, MIPI1, HDMI0, ETH,\nI2C1 (GPIO2/3), I2S (GPIO18-21), UART2, UART3, GPIO40 header, FAN_PWM/TACH, RTC_VBAT,\nPWR_BUT, nRPIBOOT, GLOBAL_EN, VIN 5V (6 A path), 3V3/1V8 outputs.\nWi-Fi antenna: CM5 U.FL -> SMA pigtail (no PCB routing)." (exclude_from_sim no) (at 15.00 25.00 0)
    (effects (font (size 1.50 1.50)) (justify left top)) (uuid "10cd7e84-4f6f-4704-aa12-b2f08b290311"))
)
